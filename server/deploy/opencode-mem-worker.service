[Unit]
Description=opencode-mem-worker (centralized memory backend)
Documentation=https://github.com/yy92calm/opencode-mem2md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/workspace/opencode-mem2md/server
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=3

# SQLite localtime() and the JS side must agree on the calendar day, otherwise
# daily summaries bucket into the wrong date. Must match `tz:` in config.yaml.
Environment=TZ=Asia/Shanghai
Environment=NODE_ENV=production

StandardOutput=append:/home/ubuntu/workspace/opencode-mem2md/server/logs/worker.log
StandardError=append:/home/ubuntu/workspace/opencode-mem2md/server/logs/worker.log

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/ubuntu/workspace/opencode-mem2md/server/data /home/ubuntu/workspace/opencode-mem2md/server/logs

[Install]
WantedBy=multi-user.target
